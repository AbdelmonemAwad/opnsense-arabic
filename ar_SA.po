msgstr "عدد المضيفين الفاشلين"

msgid "#Files Fetched"
msgstr "عدد الملفات المجلوبة"

msgid "#Files Removed"
msgstr "عدد الملفات المحذوفة"

msgid "#Hosts"
msgstr "عدد المضيفين"

msgid "#Total Files"
msgstr "إجمالي الملفات"

msgid "#Total Size"
msgstr "الحجم الإجمالي"

