"\"^https?:\\/\\/([a-zA-Z]+)\\.mydomain\\.\" يطابق "
"\"http(s)://textONLY.mydomain.*\"؛ \"\\.gif$\" يطابق \"\\*.gif\" لكن ليس "
"\"\\*.gif\\test\"؛ \"\\[0-9]+\\.gif$\" يطابق \"\\123.gif\" لكن ليس "
"\"\\test.gif\""

