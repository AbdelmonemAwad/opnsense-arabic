msgstr "منذ %s ساعات"

#, php-format
msgid "%s is currently using one of these ports."
msgstr "%s يستخدم حاليًا أحد هذه المنافذ."

#, php-format
msgid "%s is currently using this port."
msgstr "%s يستخدم هذا المنفذ حاليًا."

#, php-format
msgid "%s is not a valid IPv4 address."
msgstr "%s ليس عنوان IPv4 صالحًا."

#, php-format
msgid "%s is not a valid IPv6 address."
msgstr "%s ليس عنوان IPv6 صالحًا."

#, php-format
msgid "%s is not a valid destination IP address or alias."
msgstr "%s ليس عنوان IP أو اسمًا مستعارًا صالحًا للوجهة."

#, php-format
msgid "%s is not a valid destination alias."
msgstr "%s ليس اسمًا مستعارًا صالحًا للوجهة."

#, php-format
msgid ""
"%s is not a valid end destination port. It must be a port alias or integer "
"between 1 and 65535."
msgstr ""
"%s ليس منفذ نهاية صالحًا للوجهة. يجب أن يكون اسمًا مستعارًا لمنفذ أو عددًا "
"صحيحًا بين 1 و65535."

#, php-format
msgid ""
"%s is not a valid end source port. It must be a port alias or integer "
"between 1 and 65535."
msgstr ""
"%s ليس منفذ نهاية صالحًا للمصدر. يجب أن يكون اسمًا مستعارًا لمنفذ أو عددًا "
"صحيحًا بين 1 و65535."

#, php-format
msgid "%s is not a valid source IP address or alias."
msgstr "%s ليس عنوان IP أو اسمًا مستعارًا صالحًا للمصدر."

#, php-format
msgid "%s is not a valid source alias."
msgstr "%s ليس اسمًا مستعارًا صالحًا للمصدر."

#, php-format
msgid ""
"%s is not a valid start destination port. It must be a port alias or integer"
" between 1 and 65535."
msgstr ""
"%s ليس منفذ بداية صالحًا للوجهة. يجب أن يكون اسمًا مستعارًا لمنفذ أو عددًا "
"صحيحًا بين 1 و65535."

#, php-format
msgid ""
"%s is not a valid start source port. It must be a port alias or integer "
"between 1 and 65535."
msgstr ""
"%s ليس منفذ بداية صالحًا للمصدر. يجب أن يكون اسمًا مستعارًا لمنفذ أو عددًا "
"صحيحًا بين 1 و65535."

#, php-format
msgid "%s is only valid if the gateway is set to 'default'."
msgstr "%s صالح فقط إذا كانت البوابة مضبوطة على 'default'."

#, php-format
msgid "%s is only valid with protocol tcp."
msgstr "%s صالح فقط مع بروتوكول tcp."

#, php-format
msgid "%s made changes"
msgstr "أجرى %s تغييرات"

#, php-format
msgid "%s minute ago"
msgstr "منذ %s دقيقة"

#, php-format
msgid "%s minutes ago"
msgstr "منذ %s دقائق"

#, php-format
msgid "%s month ago"
msgstr "منذ %s شهر"

#, php-format
msgid "%s months ago"
msgstr "منذ %s أشهر"

#, php-format
msgid "%s networks"
msgstr "%s شبكات"

msgid "%s out of %s selected"
msgstr "تم تحديد %s من أصل %s"

#, php-format
msgid ""
"%s rules are evaluated on a first-match basis by default (i.e. the action of"
" the first rule to match a packet will be executed). This means that if you "
"use block rules, you will have to pay attention to the rule order. "
"Everything that is not explicitly passed is blocked by default."
msgstr ""
"تُقيَّم قواعد %s افتراضيًا على أساس أول تطابق (أي يُنفَّذ إجراء أول قاعدة "
"تطابق الحزمة). هذا يعني أنه إذا استخدمت قواعد حظر فعليك الانتباه لترتيب "
"القواعد. كل ما لا يُسمح به صراحةً يُحظر افتراضيًا."

#, php-format
msgid "%s second ago"
msgstr "منذ %s ثانية"

#, php-format
msgid "%s seconds ago"
msgstr "منذ %s ثوانٍ"

#, php-format
msgid "%s subnet"
msgstr "الشبكة الفرعية %s"

#, php-format
msgid "%s week ago"
msgstr "منذ %s أسبوع"

#, php-format
msgid "%s weeks ago"
msgstr "منذ %s أسابيع"

#, php-format
msgid "%s year ago"
msgstr "منذ %s سنة"

#, php-format
msgid "%s years ago"
msgstr "منذ %s سنوات"

#, php-format
msgid "%s0%s -- No output except fatal errors."
msgstr "%s0%s -- لا مخرجات عدا الأخطاء الفادحة."

#, php-format
msgid ""
"%s1%s -- startup info + connection initiated messages + non-fatal encryption"
" & net errors."
msgstr ""
"%s1%s -- معلومات بدء التشغيل + رسائل بدء الاتصال + أخطاء التشفير والشبكة غير"
" الفادحة."

#, php-format
msgid "%s2,3%s -- show TLS negotiations & route info."
msgstr "%s2,3%s -- عرض مفاوضات TLS ومعلومات المسارات."

#, php-format
msgid "%s4%s -- Normal usage range."
msgstr "%s4%s -- نطاق الاستخدام العادي."

#, php-format
msgid ""
"%s5%s -- Output R and W characters to the console for each packet read and "
"write, uppercase is used for TCP/UDP packets and lowercase is used for "
"TUN/TAP packets."
msgstr ""
"%s5%s -- إخراج الحرفين R وW إلى وحدة التحكم لكل عملية قراءة وكتابة للحزم، "
"وتُستخدم الأحرف الكبيرة لحزم TCP/UDP والصغيرة لحزم TUN/TAP."

#, php-format
msgid "%s6%s-%s11%s -- Debug info range."
msgstr "%s6%s-%s11%s -- نطاق معلومات التصحيح."

msgid ""
"%sApply changes:%s Apply all changes by syncing all shown SSL certificates "
"into running HAProxy service."
msgstr ""
"%sتطبيق التغييرات:%s تطبيق كل التغييرات بمزامنة كل شهادات SSL المعروضة في "
"خدمة HAProxy العاملة."

msgid ""
"%sBackend Pools:%s The HAProxy backend. Group the %spreviously added "
"servers%s to build a server farm. All servers in a group usually deliver the"
" same content. The Backend Pool cares for health monitoring and load "
"distribution. A Backend Pool must also be configured if you only have a "
"single server. The same Backend Pool may be used for multiple Public "
"Services."
msgstr ""
"%sمجمّعات الخوادم الخلفية:%s خلفية HAProxy. اجمع %sالخوادم المضافة سابقًا%s "
"لبناء مزرعة خوادم. كل الخوادم في المجموعة تقدم عادةً المحتوى نفسه. يتولى "
"مجمّع الخوادم الخلفية مراقبة الصحة وتوزيع الحمل. يجب أيضًا إعداد مجمّع خوادم"
" خلفية حتى لو كان لديك خادم واحد فقط. يمكن استخدام مجمّع الخوادم الخلفية "
"نفسه لعدة خدمات عامة."

msgid ""
"%sBuypass:%s A commercial, european certificate authority, based in Norway. "
"Check out %stheir documentation%s for details about rate-limits and the "
"usage policy."
msgstr ""
"%sBuypass:%s مرجع مصدق تجاري أوروبي مقره النرويج. راجع %sتوثيقه%s لتفاصيل "
"حدود المعدل وسياسة الاستخدام."

#, php-format
msgid ""
"%sClick here%s for PPP-specific configuration options.  Save first if you "
"made changes."
msgstr ""
"%sانقر هنا%s لخيارات الإعداد الخاصة بـ PPP.  احفظ أولًا إذا أجريت تغييرات."

msgid ""
"%sConditions:%s HAProxy is capable of extracting data from requests, "
"responses and other connection data and match it against predefined "
"patterns. Use these powerful patterns to compose a condition that may be "
"used in multiple Rules."
msgstr ""
"%sالشروط:%s يستطيع HAProxy استخراج البيانات من الطلبات والاستجابات وبيانات "
"الاتصال الأخرى ومطابقتها مع أنماط محددة مسبقًا. استخدم هذه الأنماط القوية "
"لتكوين شرط يمكن استخدامه في عدة قواعد."

msgid ""
"%sDNS-01:%s This is the most reliable challenge type and thus highly "
"recommended when using this plugin. It requires that you control the DNS for"
" your domain name and that your DNS provider is supported both %sby "
"acme.sh%s and this plugin."
msgstr ""
"%sDNS-01:%s هذا نوع التحدي الأكثر موثوقية ولذلك يُنصح به بشدة عند استخدام "
"هذا المكوّن الإضافي. يتطلب أن تتحكم في DNS لاسم نطاقك وأن يكون مزوّد DNS "
"مدعومًا %sفي acme.sh%s وفي هذا المكوّن الإضافي."

msgid ""
"%sEnable%s the plugin: When enabling this plugin on the %ssettings%s page, a"
" lightweight service is started and a cron job is added to run periodic "
"tasks."
msgstr ""
"%sفعّل%s المكوّن الإضافي: عند تفعيل هذا المكوّن الإضافي في صفحة "
"%sالإعدادات%s، تبدأ خدمة خفيفة وتُضاف مهمة cron لتشغيل المهام الدورية."

msgid ""
"%sGoogle:%s A commercial certificate authority. More information is "
"available from %stheir documentation%s."
msgstr "%sGoogle:%s مرجع مصدق تجاري. تتوفر معلومات أكثر في %sتوثيقه%s."

msgid ""
"%sGroup:%s A optional list containing one or more users. Groups usually make"
" it easier to manage permissions for a large number of users"
msgstr ""
"%sالمجموعة:%s قائمة اختيارية تحتوي على مستخدم أو أكثر. تسهّل المجموعات عادةً"
" إدارة الصلاحيات لعدد كبير من المستخدمين"

msgid ""
"%sHealth Monitors:%s The HAProxy \"health checks\". Health Monitors are used"
" by %sBackend Pools%s to determine if a server is still able to respond to "
"client requests. If a server fails a health check it will automatically be "
"removed from a Backend Pool and healthy servers are automatically re-added."
msgstr ""
"%sمراقبو الصحة:%s \"الفحوص الصحية\" في HAProxy. تستخدم %sمجمّعات الخوادم "
"الخلفية%s مراقبي الصحة لتحديد ما إذا كان الخادم لا يزال قادرًا على الرد على "
"طلبات العملاء. إذا فشل خادم في فحص صحي فسيُزال تلقائيًا من مجمّع الخوادم "
"الخلفية، وتُعاد إضافة الخوادم السليمة تلقائيًا."

#, php-format
msgid "%sKeep state%s is used for stateful connection tracking."
msgstr "يُستخدم %sKeep state%s لتتبّع الاتصالات ذات الحالة."

msgid ""
"%sNOTE:%s Changes can only be applied for Public Services that already exist"
" in the running HAProxy service. When adding or removing Public Services "
"HAProxy must be reloaded or restarted."
msgstr ""
"%sملاحظة:%s يمكن تطبيق التغييرات فقط على الخدمات العامة الموجودة مسبقًا في "
"خدمة HAProxy العاملة. عند إضافة خدمات عامة أو إزالتها يجب إعادة تحميل "
"HAProxy أو إعادة تشغيله."

msgid ""
"%sNOTE:%s These changes will not be persisted across restarts of HAProxy."
msgstr "%sملاحظة:%s لن تُحفظ هذه التغييرات عبر عمليات إعادة تشغيل HAProxy."

msgid ""
"%sNOTE:%s When enabling multiple cron jobs, please adjust them so that they "
"do not run at the same time. Check the %scron settings page%s for more cron "
"job details and additional customization options."
msgstr ""
"%sملاحظة:%s عند تفعيل عدة مهام cron، يرجى ضبطها بحيث لا تعمل في الوقت نفسه. "
"راجع %sصفحة إعدادات cron%s لمزيد من تفاصيل مهام cron وخيارات التخصيص "
"الإضافية."

#, php-format
msgid ""
"%sNone%s: Do not use state mechanisms to keep track. This is only useful if "
"you're doing advanced queueing in certain situations. Please check the "
"documentation."
msgstr ""
"%sبلا%s: عدم استخدام آليات الحالة للتتبّع. هذا مفيد فقط عند استخدام قوائم "
"انتظار متقدمة في حالات معيّنة. يرجى مراجعة التوثيق."

msgid ""
"%sPublic Services:%s The HAProxy frontend. The Public Service listens for "
"client connections, optionally applies rules and forwards client request "
"data to the selected Backend Pool for load balancing or proxying. Every "
"Public Service needs to be connected to a %spreviously created Backend "
"Pool%s."
msgstr ""
"%sالخدمات العامة:%s الواجهة الأمامية لـ HAProxy. تستمع الخدمة العامة "
"لاتصالات العملاء، وتطبّق القواعد اختياريًا، وتحوّل بيانات طلبات العملاء إلى "
"مجمّع الخوادم الخلفية المحدد لموازنة الحمل أو التمرير عبر الوكيل. يجب ربط كل"
" خدمة عامة بـ %sمجمّع خوادم خلفية مُنشأ سابقًا%s."

msgid "%sResult %s%s"
msgstr "%sالنتيجة %s%s"

msgid ""
"%sRules:%s Perform a large set of actions if one or more %sConditions%s "
"match. These Rules may be used in %sBackend Pools%s as well as %sPublic "
"Services%s."
msgstr ""
"%sالقواعد:%s تنفيذ مجموعة كبيرة من الإجراءات إذا طابق %sشرط%s واحد أو أكثر. "
"يمكن استخدام هذه القواعد في %sمجمّعات الخوادم الخلفية%s وكذلك في %sالخدمات "
"العامة%s."

msgid ""
"%sSSL.com:%s A commercial, globally trusted certificate authority. They "
"provide an %sextensive guide%s for using their paid services with the ACME "
"protocol."
msgstr ""
"%sSSL.com:%s مرجع مصدق تجاري موثوق عالميًا. يوفر %sدليلًا شاملًا%s لاستخدام "
"خدماته المدفوعة مع بروتوكول ACME."

msgid ""
"%sServer Templates:%s A prefix is required to build the server names. "
"Additionally a service name or FQDN is required to identify the servers this"
" template initializes"
msgstr ""
"%sقوالب الخوادم:%s تلزم بادئة لبناء أسماء الخوادم. بالإضافة إلى ذلك يلزم اسم"
" خدمة أو FQDN لتمييز الخوادم التي يهيّئها هذا القالب"

msgid ""
"%sSet state to drain:%s This removes the server from load balancing. Health "
"checks will continue to run and it still accepts new persistent connections."
msgstr ""
"%sتعيين الحالة إلى تصريف:%s يزيل هذا الخادم من موازنة الحمل. تستمر الفحوص "
"الصحية ويظل يقبل الاتصالات الدائمة الجديدة."

msgid ""
"%sSet state to maintenance:%s This disables any traffic to the server. "
"Health checks will also be disabled."
msgstr ""
"%sتعيين الحالة إلى صيانة:%s يعطّل هذا أي حركة مرور إلى الخادم. ستُعطَّل "
"الفحوص الصحية أيضًا."

msgid "%sSet state to ready:%s This puts the server in normal mode."
msgstr "%sتعيين الحالة إلى جاهز:%s يضع هذا الخادم في الوضع العادي."

msgid ""
"%sShow diff:%s Show difference between configured SSL certificates and SSL "
"certificates from the running HAProxy service."
msgstr ""
"%sعرض الفروق:%s عرض الفرق بين شهادات SSL المُعدّة وشهادات SSL في خدمة "
"HAProxy العاملة."

#, php-format
msgid ""
"%sSloppy state%s works like keep state, but it does not check sequence "
"numbers. Use it when the firewall does not see all packets."
msgstr ""
"%sSloppy state%s يعمل مثل keep state لكنه لا يتحقق من أرقام التسلسل. استخدمه"
" عندما لا يرى جدار الحماية كل الحزم."

msgid ""
"%sStatic Servers:%s The IP address or fully-qualified domain name that "
"should be used when communicating with your server. Additionally the TCP or "
"UDP port that should be used. If unset, the same port the client connected "
"to will be used."
msgstr ""
"%sالخوادم الثابتة:%s عنوان IP أو اسم النطاق المؤهل بالكامل الذي يجب استخدامه"
" عند الاتصال بخادمك. بالإضافة إلى منفذ TCP أو UDP الذي يجب استخدامه. إذا لم "
"يُعيَّن، فسيُستخدم المنفذ نفسه الذي اتصل به العميل."

#, php-format
msgid ""
"%sSynproxy state%s proxies incoming TCP connections to help protect servers "
"from spoofed TCP SYN floods. This option includes the functionality of keep "
"state and modulate state combined."
msgstr ""
"%sSynproxy state%s يمرّر اتصالات TCP الواردة عبر وكيل للمساعدة في حماية "
"الخوادم من هجمات إغراق TCP SYN المنتحلة. يجمع هذا الخيار وظائف keep state "
"وmodulate state."

msgid ""
"%sUser:%s A username/password combination. Both secure (encrypted) and "
"insecure (unencrypted) passwords can be used."
msgstr ""
"%sالمستخدم:%s تركيبة اسم مستخدم/كلمة مرور. يمكن استخدام كلمات مرور آمنة "
"(مشفرة) وغير آمنة (غير مشفرة)."

#, php-format
msgid "%sdefault%s-%s4%s -- Normal usage range."
msgstr "%sdefault%s-%s4%s -- نطاق الاستخدام العادي."

#, php-format
msgid "%snone%s -- No output except fatal errors."
msgstr "%snone%s -- لا مخرجات عدا الأخطاء الفادحة."

#, possible-php-format
msgid "'%s' in '%s' is not a single valid %s CIDR range"
msgstr "'%s' في '%s' ليس نطاق %s CIDR واحدًا صالحًا"

#, possible-php-format
msgid ""
"'%s' in '%s' may only contain valid %s CIDR range(s) separated by commas."
