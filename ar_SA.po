msgid ""
"\n"
"      Are you sure you do want to disable this host?\n"
"      When being used in other virtual servers it will be disabled in there as well."
msgstr ""
"\n"
"      هل أنت متأكد أنك تريد تعطيل هذا المضيف؟\n"
"      إذا كان مستخدمًا في خوادم افتراضية أخرى فسيُعطَّل فيها أيضًا."

msgid ""
"\n"
"      Are you sure you do want to enable this host?\n"
"      When being used in other virtual servers it will be enabled in there as well."
msgstr ""
"\n"
"      هل أنت متأكد أنك تريد تفعيل هذا المضيف؟\n"
"      إذا كان مستخدمًا في خوادم افتراضية أخرى فسيُفعَّل فيها أيضًا."

#, php-format
msgid "\"%s\" is not a valid redirect target IP address, network or host alias."
msgstr ""
"\"%s\" ليس عنوان IP أو شبكة أو اسمًا مستعارًا لمضيف صالحًا كهدف لإعادة "
"التوجيه."

msgid "#"
msgstr "#"

msgid "#1"
msgstr "#1"

msgid "#2"
msgstr "#2"

