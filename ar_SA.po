msgstr "الأفضلية"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Radvd/forms/dialogEntry.xml
msgid "Deprecate Prefix"
msgstr "إهمال البادئة"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Radvd/forms/dialogEntry.xml
msgid ""
"Deprecate advertised prefixes on shutdown by announcing a zero preferred "
"lifetime."
msgstr "إهمال البادئات المُعلن عنها عند الإيقاف بالإعلان عن مدة تفضيل صفرية."

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Radvd/forms/dialogEntry.xml
