msgstr "منذ %s أيام"

#, php-format
msgid "%s doesn't appear to be a valid port number, alias or range"
msgstr "يبدو أن %s ليس رقم منفذ أو اسمًا مستعارًا أو نطاقًا صالحًا"

#, php-format
msgid "%s hour ago"
msgstr "منذ %s ساعة"

#, php-format
