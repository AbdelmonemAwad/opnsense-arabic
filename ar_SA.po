msgid "General access"
msgstr "الوصول العام"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Base/ApiControllerBase.php
#, php-format
msgid ""
"User %s denied for write access due to the sensitive nature of this "
"component (requires page-all priv)"
msgstr ""
"رُفض وصول المستخدم %s للكتابة بسبب الطبيعة الحساسة لهذا المكوّن (يتطلب "
