"\"*.mydomain.com\"; \"^https?:\\/\\/([a-zA-Z]+)\\.mydomain\\.\" matches on "
"\"http(s)://textONLY.mydomain.*\"; \"\\.gif$\" matches on \"\\*.gif\" but "
"not on \"\\*.gif\\test\"; \"\\[0-9]+\\.gif$\" matches on \"\\123.gif\" but "
"not on \"\\test.gif\""
