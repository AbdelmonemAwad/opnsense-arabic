#, php-format
msgid "Cannot delete alias %s. Currently in use by %s"
msgstr "لا يمكن حذف الاسم المستعار %s. مستخدم حاليًا بواسطة %s"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Firewall/Api/AliasController.php
msgid "Update completed"
msgstr "اكتمل التحديث"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Firewall/Api/AliasController.php
msgid "Error updating action"
msgstr "خطأ في تحديث الإجراء"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Firewall/Api/FilterBaseController.php
#, php-format
msgid "%s network"
msgstr "شبكة %s"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Firewall/Api/FilterBaseController.php
msgid "Single port or range"
msgstr "منفذ واحد أو نطاق"

#: usr/local/opnsense/mvc/app/controllers/OPNsense/Firewall/Api/FilterController.php
