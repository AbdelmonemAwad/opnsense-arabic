msgstr "الوجهة"

msgid "Destination / Invert"
msgstr "الوجهة / عكس"

msgid "Destination Address"
msgstr "عنوان الوجهة"

msgid "Destination IP"
msgstr "عنوان IP للوجهة"

msgid "Destination Port"
msgstr "منفذ الوجهة"

msgid "Destination network"
msgstr "شبكة الوجهة"

msgid "Destination network for this static route"
msgstr "شبكة الوجهة لهذا المسار الثابت"

msgid "Destination port"
msgstr "منفذ الوجهة"

msgid ""
"Destination port number or well known name (imap, imaps, http, https, ...)"
msgstr "رقم منفذ الوجهة أو اسم معروف (imap وimaps وhttp وhttps وغيرها)"

msgid ""
"Destination port number or well known name (imap, imaps, http, https, ...), "
"for ranges use a dash"
msgstr ""
"رقم منفذ الوجهة أو اسم معروف (imap وimaps وhttp وhttps وغيرها)، وللنطاقات "
"استخدم شرطة"

msgid "Destinations"
msgstr "الوجهات"

msgid ""
"Destinations to forward requests to, one destination per line. When type is "
"Redirect or Exchange Server, only a single destination is allowed."
msgstr ""
"الوجهات لتحويل الطلبات إليها، وجهة واحدة في كل سطر. عندما يكون النوع "
"Redirect أو Exchange Server، يُسمح بوجهة واحدة فقط."

msgid "Detailed Logging"
msgstr "تسجيل مفصّل"

msgid "Detect Profile"
msgstr "ملف تعريف الاكتشاف"

msgid "Detect broken executables"
msgstr "اكتشاف الملفات التنفيذية المعطوبة"

msgid "Detection"
msgstr "الاكتشاف"

msgid ""
"Determines the likelihood of becoming a Designated Router; higher values "
"increase priority."
msgstr ""
"يحدد احتمال أن يصبح موجّهًا معيّنًا (Designated Router)؛ القيم الأعلى تزيد "
"الأولوية."

msgid "Device"
msgstr "الجهاز"

msgid "Device ID"
msgstr "معرّف الجهاز"

msgid "Device Name"
msgstr "اسم الجهاز"

msgid "Device Statistics"
msgstr "إحصائيات الجهاز"

msgid "Digest Algorithm"
msgstr "خوارزمية الملخّص"

msgid "Digest Algorithm to use when creating new certificates."
msgstr "خوارزمية الملخّص المستخدمة عند إنشاء شهادات جديدة."

msgid "DigitalOcean"
msgstr "DigitalOcean"

msgid "DirectAdmin"
msgstr "DirectAdmin"

msgid "Direction"
msgstr "الاتجاه"

msgid "Directive"
msgstr "التوجيه (Directive)"

msgid "Directory Port"
msgstr "منفذ الدليل"

msgid ""
"Disable 204 responses outside previews for virus_scan if your ICAP client "
"does not support it."
msgstr ""
"تعطيل ردود 204 خارج المعاينات لـ virus_scan إذا كان عميل ICAP لا يدعمها."

msgid "Disable Bot Protection"
msgstr "تعطيل الحماية من الروبوتات"

msgid "Disable Commands"
msgstr "تعطيل الأوامر"

msgid "Disable Connected Check"
msgstr "تعطيل فحص الاتصال"

msgid "Disable Expansion"
msgstr "تعطيل التوسيع"

msgid "Disable Gateway Monitoring"
msgstr "تعطيل مراقبة البوابة"

msgid "Disable Graphite SSL/TLS"
msgstr "تعطيل SSL/TLS لـ Graphite"

msgid "Disable HA sync"
msgstr "تعطيل مزامنة HA"

msgid "Disable Host Route"
msgstr "تعطيل مسار المضيف"

msgid "Disable IPv4"
msgstr "تعطيل IPv4"

msgid "Disable IPv6"
msgstr "تعطيل IPv6"

msgid "Disable Ingress filtering"
msgstr "تعطيل تصفية الدخول (Ingress)"

msgid "Disable LAN"
msgstr "تعطيل LAN"

msgid "Disable LAN, usually only relevant in \"wan\" only scenarios."
msgstr "تعطيل LAN، ويتعلق عادةً فقط بسيناريوهات \"wan\" فقط."

msgid "Disable Prefetching"
msgstr "تعطيل الجلب المسبق"

msgid "Disable Propagation Timeout"
msgstr "تعطيل مهلة الانتشار"

msgid "Disable SNAT"
msgstr "تعطيل SNAT"

msgid "Disable SSL Verification"
msgstr "تعطيل التحقق من SSL"

msgid "Disable SSL verification"
msgstr "تعطيل التحقق من SSL"

msgid "Disable SSL verification v2"
msgstr "تعطيل التحقق من SSL ‏v2"

msgid "Disable SSLv2 and SSLv3, only TLS allowed."
msgstr "تعطيل SSLv2 وSSLv3، والسماح بـ TLS فقط."

msgid "Disable Security Rules by ID"
msgstr "تعطيل قواعد الأمان حسب المعرّف"

msgid "Disable TLS Verification"
msgstr "تعطيل التحقق من TLS"

msgid "Disable TLS session tickets - increases privacy but also latency."
msgstr "تعطيل تذاكر جلسات TLS - يزيد الخصوصية لكنه يزيد زمن الانتقال أيضًا."

msgid "Disable TLS verification"
msgstr "تعطيل التحقق من TLS"

msgid "Disable cache"
msgstr "تعطيل الذاكرة المؤقتة"

msgid ""
"Disable configuration file generation and manage the file "
"(/usr/local/etc/kea/kea-dhcp4.conf) manually."
msgstr ""
"تعطيل توليد ملف الإعدادات وإدارة الملف ‏(/usr/local/etc/kea/kea-dhcp4.conf) "
"يدويًا."

msgid ""
"Disable configuration file generation and manage the file "
"(/usr/local/etc/kea/kea-dhcp6.conf) manually."
msgstr ""
"تعطيل توليد ملف الإعدادات وإدارة الملف ‏(/usr/local/etc/kea/kea-dhcp6.conf) "
"يدويًا."

msgid ""
"Disable expansion of this entry into IPs on NAT lists (e.g. 192.168.1.0/24 "
"expands to 256 entries."
msgstr ""
"تعطيل توسيع هذا الإدخال إلى عناوين IP في قوائم NAT (مثلًا 192.168.1.0/24 "
"يتوسع إلى 256 إدخالًا."

msgid "Disable firewall rules"
msgstr "تعطيل قواعد جدار الحماية"

msgid "Disable gzip"
msgstr "تعطيل gzip"

msgid "Disable legacy auto-added VPN rules."
msgstr "تعطيل قواعد VPN القديمة المضافة تلقائيًا."

msgid "Disable password save"
msgstr "تعطيل حفظ كلمة المرور"

msgid "Disable preempt"
msgstr "تعطيل الاستباق (preempt)"

msgid "Disable reply-to"
msgstr "تعطيل reply-to"

msgid "Disable routes"
msgstr "تعطيل المسارات"

msgid "Disable source NAT to disable subnet routing (experimental)."
msgstr "تعطيل NAT المصدر لتعطيل توجيه الشبكات الفرعية (تجريبي)."

msgid "Disabled"
msgstr "معطّل"

msgid "Disabled RPCs"
msgstr "استدعاءات RPC المعطّلة"

msgid "Disabled Servers List"
msgstr "قائمة الخوادم المعطّلة"

msgid ""
"Disables OSPF Hello packets on the interface, preventing neighbor "
"relationships (used for security or optimization)."
msgstr ""
"يعطّل حزم OSPF Hello على الواجهة، مما يمنع علاقات الجوار (يُستخدم للأمان أو "
"التحسين)."

msgid ""
"Disables responses gzipping. Makes sense if TLS is used and this method of "
"BREACH attack protection is preferred."
msgstr ""
"يعطّل ضغط الاستجابات بـ gzip. منطقي إذا كان TLS مستخدمًا وكانت هذه الطريقة "
"مفضلة للحماية من هجوم BREACH."

msgid "Discard Timeout"
msgstr "مهلة التجاهل"

msgid "Disconnect dialup interfaces"
msgstr "قطع اتصال واجهات الطلب الهاتفي"

msgid "Disk"
msgstr "القرص"

msgid "Disk I/O Timeout for Swap Operations (msec)"
msgstr "مهلة إدخال/إخراج القرص لعمليات التبديل (ميلي ثانية)"

msgid "Disk I/O Timeout for Swap Operations (swaps/sec)"
msgstr "مهلة إدخال/إخراج القرص لعمليات التبديل (تبديلات/ثانية)"

msgid "Disk IO"
msgstr "إدخال/إخراج القرص"

msgid "Disk Ignore FS"
msgstr "أنظمة الملفات المتجاهلة للقرص"

msgid "Disk Mount Points"
msgstr "نقاط تركيب الأقراص"

msgid "Display Version in OID"
msgstr "عرض الإصدار في OID"

msgid "Do Not Use"
msgstr "عدم الاستخدام"

msgid "Do not NAT"
msgstr "بدون NAT"

msgid ""
"Do not attempt to resolve hostnames: logs will contain IP addresses. This is"
" mostly useful if the system's DNS is slow and running the sslh-select "
"variant, as DNS requests will hang all connections. Default: false"
msgstr ""
"عدم محاولة تحليل أسماء المضيفين: ستحتوي السجلات على عناوين IP. هذا مفيد "
"غالبًا إذا كان DNS للنظام بطيئًا ويعمل إصدار sslh-select، إذ ستعلّق طلبات "
"DNS كل الاتصالات. الافتراضي: false"

msgid "Do not create a dedicated host route for this monitor."
msgstr "عدم إنشاء مسار مضيف مخصص لهذا المراقب."

msgid ""
"Do not decode and/or filter SSL content, only log requested domains and IP "
"addresses. Some old servers may not provide SNI, so their addresses will not"
" be indicated."
msgstr ""
"عدم فك ترميز محتوى SSL و/أو تصفيته، وتسجيل النطاقات وعناوين IP المطلوبة فقط."
" قد لا توفر بعض الخوادم القديمة SNI، لذا لن تُذكر عناوينها."

msgid "Do not forward private reverse lookups"
msgstr "عدم تحويل عمليات البحث العكسي الخاصة"

msgid "Do not forward to system defined DNS servers"
msgstr "عدم التحويل إلى خوادم DNS المعرّفة في النظام"

msgid "Do not fragment"
msgstr "عدم التجزئة"

msgid "Do not keep data longer than N seconds in buffer."
msgstr "عدم الاحتفاظ بالبيانات في المخزن أكثر من N ثانية."

msgid ""
"Do not provide DHCP, TFTP or router advertisement on the specified "
"interfaces, but do provide DNS service. Please note that Dnsmasq continues "
"to listen on the default DHCP ports as long as any DHCP ranges are "
