#: usr/local/opnsense/mvc/app/controllers/OPNsense/Postfix/forms/general.xml
#, php-format
msgid ""
"\n"
"            <ul>\n"
"                <li>'none' will disable TLS for sending mail.</li>\n"
"                <li>'may' will use TLS when offered (Opportunistic TLS)</li>\n"
"                <li>'encrypt' will enforce TLS on all connections. Please do not use this for Internet wide communication as not every server supports TLS yet.</li>\n"
"                <li>'dane' will enforce TLS if a TLSA-Record is published (Opportunistic DANE, RFC 7672). DNSSEC-capable resolver is required.</li>\n"
"            </ul> "
msgstr ""
"\n"
"            <ul><li>'none' يعطّل TLS عند إرسال البريد.</li><li>'may' يستخدم TLS عند توفره (TLS الانتهازي)</li><li>'encrypt' يفرض TLS على جميع الاتصالات. يُرجى عدم استخدامه للاتصال عبر الإنترنت عمومًا، إذ لا تدعم جميع الخوادم TLS بعد.</li><li>'dane' يفرض TLS إذا نُشر سجل TLSA (DANE الانتهازي، RFC 7672). يلزم محلل يدعم DNSSEC.</li></ul> "

