msgstr "تفعيل المكوّن الإضافي network"

msgid "Enable nginx"
msgstr "تفعيل nginx"

msgid "Enable ntopng"
msgstr "تفعيل ntopng"

msgid "Enable old bogus PROXY v2 implementation"
msgstr "تفعيل تطبيق PROXY v2 القديم المعطوب"

msgid ""
"Enable or disable Dynamic DNS. Requires a \"DNS Provider\" in \"General "
"Settings\". The DNS records of this domain will be automatically updated. A "
"wildcard domain will create a \"*.example.com\" record. A base domain will "
"create a \"example.com\" or \"opn.example.com\" record. Some providers need "
"subdomains to set records for domains like \"opn.example.com\"; in that case"
" use the checkbox in the subdomains tab."
msgstr ""
"تفعيل أو تعطيل DNS الديناميكي. يتطلب \"DNS Provider\" في \"General "
"Settings\". ستُحدَّث سجلات DNS لهذا النطاق تلقائيًا. نطاق wildcard سينشئ سجل"
" \"*.example.com\". النطاق الأساسي سينشئ سجل \"example.com\" أو "
"\"opn.example.com\". يحتاج بعض المزوّدين إلى نطاقات فرعية لتعيين سجلات "
"لنطاقات مثل \"opn.example.com\"؛ في هذه الحالة استخدم مربع الاختيار في تبويب"
" النطاقات الفرعية."

msgid ""
"Enable or disable Dynamic DNS. Requires a \"DNS Provider\" in \"General "
"Settings\". The DNS records of this subdomain will be automatically updated."
msgstr ""
"تفعيل أو تعطيل DNS الديناميكي. يتطلب \"DNS Provider\" في \"General "
"Settings\". ستُحدَّث سجلات DNS لهذا النطاق الفرعي تلقائيًا."

msgid ""
"Enable or disable Forward Auth. Requires an \"Auth Provider\" in \"General "
"Settings\". Headers are set automatically to the standard of the chosen "
"provider. Enabling this option will additionally generate the forward_auth "
"directive in front of the reverse_proxy directive inside the scope of this "
"handler."
msgstr ""
"تفعيل أو تعطيل مصادقة التحويل (Forward Auth). يتطلب \"Auth Provider\" في "
"\"General Settings\". تُعيَّن الترويسات تلقائيًا وفق معيار المزوّد المختار. "
"تفعيل هذا الخيار سيولّد أيضًا توجيه forward_auth أمام توجيه reverse_proxy "
"ضمن نطاق هذا المعالج."

msgid ""
"Enable or disable HAProxy peers. This will propagate entries of any data-"
"types in stick-tables between several HAProxy instances over TCP connections"
" in a multi-master fashion."
msgstr ""
"تفعيل أو تعطيل نظراء HAProxy. سينشر ذلك إدخالات أي نوع بيانات في stick-"
"tables بين عدة مثيلات HAProxy عبر اتصالات TCP بأسلوب متعدد الرئيسيات."

msgid ""
"Enable or disable HTTP over TLS (HTTPS) to communicate with the Forward Auth"
" Provider."
msgstr "تفعيل أو تعطيل HTTP عبر TLS ‏(HTTPS) للاتصال بمزوّد مصادقة التحويل."

msgid ""
"Enable or disable HTTP over TLS (HTTPS) to communicate with the upstream "
"destination. Caddy uses HTTP with the upstream destination by default."
msgstr ""
"تفعيل أو تعطيل HTTP عبر TLS ‏(HTTPS) للاتصال بوجهة الخادم الأعلى. يستخدم "
"Caddy افتراضيًا HTTP مع وجهة الخادم الأعلى."

msgid ""
"Enable or disable NTLM. Needed to reverse proxy an Exchange Server. Warning:"
" NTLM has been deprecated by Microsoft. This option will stay for as long as"
" the optional http.reverse_proxy.transport.http_ntlm module can be compiled "
"without errors."
msgstr ""
"تفعيل أو تعطيل NTLM. مطلوب للوكيل العكسي لخادم Exchange. تحذير: أهملت "
"Microsoft بروتوكول NTLM. سيبقى هذا الخيار ما دامت الوحدة الاختيارية "
"http.reverse_proxy.transport.http_ntlm قابلة للتجميع دون أخطاء."

msgid "Enable or disable Relayd."
msgstr "تفعيل أو تعطيل Relayd."

msgid "Enable or disable SSL communication with this server."
msgstr "تفعيل أو تعطيل اتصال SSL مع هذا الخادم."

msgid "Enable or disable SSL server certificate verification."
msgstr "تفعيل أو تعطيل التحقق من شهادة خادم SSL."

msgid "Enable or disable alert."
msgstr "تفعيل أو تعطيل التنبيه."

msgid ""
"Enable or disable collecting & providing separate statistics for each "
"socket."
msgstr "تفعيل أو تعطيل جمع وتوفير إحصائيات منفصلة لكل مقبس."

msgid "Enable or disable health checking."
msgstr "تفعيل أو تعطيل الفحص الصحي."

msgid "Enable or disable logging of connections with no data."
msgstr "تفعيل أو تعطيل تسجيل الاتصالات التي لا تحمل بيانات."

msgid "Enable or disable logging of normal, successful connections."
msgstr "تفعيل أو تعطيل تسجيل الاتصالات العادية الناجحة."

msgid "Enable or disable monit."
msgstr "تفعيل أو تعطيل monit."

msgid "Enable or disable ndproxy."
msgstr "تفعيل أو تعطيل ndproxy."

msgid "Enable or disable service checks."
msgstr "تفعيل أو تعطيل فحوص الخدمات."

msgid ""
"Enable or disable session redistribution in case of connection failure."
msgstr "تفعيل أو تعطيل إعادة توزيع الجلسات في حال فشل الاتصال."

msgid "Enable or disable the Caddy web server."
msgstr "تفعيل أو تعطيل خادم الويب Caddy."

msgid "Enable or disable the FritzBox Anoncall plugin."
msgstr "تفعيل أو تعطيل المكوّن الإضافي FritzBox Anoncall."

msgid "Enable or disable the HAProxy service."
msgstr "تفعيل أو تعطيل خدمة HAProxy."

msgid "Enable or disable the Redis service."
msgstr "تفعيل أو تعطيل خدمة Redis."

msgid "Enable or disable the STUN plugin."
msgstr "تفعيل أو تعطيل المكوّن الإضافي STUN."

msgid ""
"Enable or disable the caching of Windows updates. This makes sense if you "
"don't have a WSUS server. If you can setup a WSUS server, this solution "
"should be preferred."
msgstr ""
"تفعيل أو تعطيل التخزين المؤقت لتحديثات Windows. هذا منطقي إذا لم يكن لديك "
"خادم WSUS. إذا أمكنك إعداد خادم WSUS فيُفضَّل هذا الحل."

msgid ""
"Enable or disable the caching of packages for linux distributions. This "
"makes sense if you have multiple servers in your network and do not host "
"your own package mirror. This will reduce internet traffic usage but "
"increase disk access."
msgstr ""
"تفعيل أو تعطيل التخزين المؤقت لحزم توزيعات لينكس. هذا منطقي إذا كانت لديك "
"عدة خوادم في شبكتك ولا تستضيف مرآة حزم خاصة بك. سيقلل ذلك استهلاك الإنترنت "
"لكنه يزيد الوصول إلى القرص."

msgid "Enable or disable the defaulttarget plugin."
msgstr "تفعيل أو تعطيل المكوّن الإضافي defaulttarget."

msgid "Enable or disable the fix_DTAG_networks plugin."
msgstr "تفعيل أو تعطيل المكوّن الإضافي fix_DTAG_networks."

msgid "Enable or disable the fix_bogus_via plugin."
msgstr "تفعيل أو تعطيل المكوّن الإضافي fix_bogus_via."

msgid ""
"Enable or disable the local cache. Only UFS directory cache type is "
"supported. Do not enable on embedded systems with SD or CF cards as this "
"will wear down your drive."
msgstr ""
"تفعيل أو تعطيل الذاكرة المؤقتة المحلية. نوع ذاكرة مجلد UFS فقط مدعوم. لا "
"تفعّله على الأنظمة المدمجة ذات بطاقات SD أو CF لأنه سيؤدي إلى تآكل الوسيط."

msgid ""
"Enable or disable the nut service. If enabled, the system will shutdown when"
" the UPS emits a low battery warning."
msgstr ""
"تفعيل أو تعطيل خدمة nut. عند التفعيل سيُوقف النظام عندما يُصدر UPS تحذير "
"انخفاض البطارية."

msgid ""
"Enable or disable the processing of the Vary header. When disabled, a "
"response containing such a header will never be cached."
msgstr ""
"تفعيل أو تعطيل معالجة ترويسة Vary. عند التعطيل لن تُخزَّن أبدًا الاستجابة "
"التي تحتوي على هذه الترويسة."

msgid "Enable or disable the proxy service."
msgstr "تفعيل أو تعطيل خدمة الوكيل."

msgid "Enable or disable the rspamd service."
msgstr "تفعيل أو تعطيل خدمة rspamd."

msgid "Enable or disable the squid SNMP Agent."
msgstr "تفعيل أو تعطيل وكيل SNMP في squid."

msgid "Enable or disable this ACL."
